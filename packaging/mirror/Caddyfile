# Tether's update server: Caddy gets the HTTPS certificate by itself.
# Point tether.example.com's DNS at the server, put this in /etc/caddy/Caddyfile,
# and run bin/mirror-release /srv/tether from cron.
tether.example.com {
	root * /srv/tether
	file_server browse
	# latest.json changes with each release; the files under a version never do.
	@manifest path /latest.json
	header @manifest Cache-Control "no-cache"
	header /*/* Cache-Control "public, max-age=31536000, immutable"
}
