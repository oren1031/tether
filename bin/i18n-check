#!/usr/bin/env python3
"""Checks the translations in src/i18n against the source: every qsTr("…")
and tr("…") string needs an entry in each catalog (except en.json, which
only carries plural forms), with the same %1 and {{name}} placeholders.

    bin/i18n-check            lists what's missing, exits 1 if anything is
    bin/i18n-check --stale    also lists entries the source no longer uses
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LITERAL = r'"((?:[^"\\]|\\.)*)"'
CALL = re.compile(r'\b(?:qsTr|tr)\(\s*((?:' + LITERAL + r'\s*)+)')
PLACEHOLDER = re.compile(r'%\d|%n|\{\{\w+\}\}')
# CLDR plural categories a catalog must give for a counted string.
PLURALS = {"he": ["one", "two", "other"]}


def source_strings():
    found = {}
    for folder, _, files in os.walk(os.path.join(ROOT, "src")):
        for name in sorted(files):
            if not name.endswith((".qml", ".cpp", ".h")) or name.startswith("translator."):
                continue
            with open(os.path.join(folder, name), encoding="utf-8") as source:
                for call in CALL.finditer(source.read()):
                    parts = re.findall(LITERAL, call.group(1))
                    text = "".join(json.loads('"' + part + '"') for part in parts)
                    found.setdefault(text, name)
    return found


def main():
    strings = source_strings()
    problems = 0
    folder = os.path.join(ROOT, "src", "i18n")
    for catalog in sorted(os.listdir(folder)):
        code = catalog[:-5]
        if not catalog.endswith(".json") or code == "en":
            continue
        with open(os.path.join(folder, catalog), encoding="utf-8") as file:
            entries = json.load(file)
        for text, where in strings.items():
            entry = entries.get(text)
            if not entry:
                print(f"{catalog}: missing {json.dumps(text, ensure_ascii=False)} ({where})")
                problems += 1
                continue
            counted = "%n" in text
            if counted != isinstance(entry, dict):
                print(f"{catalog}: {json.dumps(text)} needs {'plural forms' if counted else 'one string'}")
                problems += 1
                continue
            forms = entry if counted else {"": entry}
            for category in PLURALS.get(code, ["other"]) if counted else []:
                if category not in forms:
                    print(f"{catalog}: {json.dumps(text)} has no '{category}' form")
                    problems += 1
            for category, form in forms.items():
                want = set(PLACEHOLDER.findall(text)) - {"%n"}
                got = set(PLACEHOLDER.findall(form)) - {"%n"}
                if want != got:
                    print(f"{catalog}: {json.dumps(text)} {category}: placeholders {sorted(got)}, not {sorted(want)}")
                    problems += 1
        if "--stale" in sys.argv:
            for text in entries:
                if text not in strings:
                    print(f"{catalog}: no longer used: {json.dumps(text, ensure_ascii=False)}")
    print(f"{len(strings)} strings in the source; {problems} problems")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
