#!/usr/bin/env python3
"""Copies Tether's newest release from GitHub to a folder a web server
shares, where Tether looks for updates before it asks GitHub.

    bin/mirror-release /srv/tether [--repo oren1031/tether] [--keep 3]

Run it from cron (every 15 minutes is plenty) on the server behind
https://tether.example.com, with that folder as the site's root; see
packaging/mirror/Caddyfile. Files come through GitHub's API, which works even
when GitHub's download links don't.

The folder ends up as Tether expects it:

    latest.json  latest.json.sig     the release's signed list of files
    0.5.5/<each file>                and SHA256SUMS with its signature

The list and its signature are copied byte for byte from the release: they
were made when it was published, with a key this server doesn't have, and
Tether refuses an update whose list isn't signed with it. So this server
can't change what gets installed; at worst it serves a file that doesn't
match the list, and Tether fetches GitHub's copy instead. Even so, the
signature and every file's checksum are checked here before anything is put
in place, and latest.json is written last, so Tether never sees a release
that's half copied or wrong.
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.request

API = "https://api.github.com/repos/{repo}/releases/latest"
UA = {"User-Agent": "tether-mirror"}
# The public half of the key releases are signed with: the same one that is
# built into Tether (src/updater.cpp) and install.sh.
UPDATE_KEY = "AAAAC3NzaC1lZDI1NTE5AAAAIGlNzf+gXq5FiE2CBcdgvlgMfKFqLNDo4wnYITdFhF2Q"
NAMESPACE = "tether-update"


def fetch(url, accept, token=None):
    headers = dict(UA, Accept=accept)
    if token:
        headers["Authorization"] = "Bearer " + token
    return urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=120)


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as source:
        for chunk in iter(lambda: source.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def signed_by_tether(path, key):
    """True when path.sig is the update key's signature of path; None when
    there's no ssh-keygen here to ask."""
    if not shutil.which("ssh-keygen"):
        return None
    with tempfile.TemporaryDirectory() as scratch:
        signers = os.path.join(scratch, "allowed_signers")
        with open(signers, "w", encoding="utf-8") as out:
            out.write(f'{NAMESPACE} namespaces="{NAMESPACE}" ssh-ed25519 {key}\n')
        with open(path, "rb") as signed:
            done = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", signers, "-I", NAMESPACE,
                                   "-n", NAMESPACE, "-s", path + ".sig"],
                                  stdin=signed, capture_output=True)
    return done.returncode == 0


def put(source, target):
    """Copies a file into place in one step, readable by the web server."""
    with tempfile.NamedTemporaryFile(dir=os.path.dirname(target), delete=False) as part:
        with open(source, "rb") as data:
            shutil.copyfileobj(data, part)
    os.chmod(part.name, 0o644)
    os.replace(part.name, target)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("folder", help="the folder the web server shares")
    parser.add_argument("--repo", default="oren1031/tether")
    parser.add_argument("--keep", type=int, default=3, help="older versions to keep")
    parser.add_argument("--key", default=UPDATE_KEY,
                        help="the public key releases are signed with (a fork's own)")
    args = parser.parse_args()
    token = os.environ.get("GITHUB_TOKEN")  # optional, for GitHub's rate limits

    release = json.load(fetch(API.format(repo=args.repo), "application/vnd.github+json", token))
    version = release["tag_name"].lstrip("vV")
    if not version or not all(part.isdigit() for part in version.split(".")):
        sys.exit(f"{release['tag_name']!r} isn't a version")
    folder = os.path.abspath(args.folder)
    target = os.path.join(folder, version)
    os.makedirs(target, exist_ok=True)

    names = []
    for asset in release["assets"]:
        name = asset["name"]
        if "-debug-" in name or name.endswith(".png") or os.path.basename(name) != name or name.startswith("."):
            continue
        path = os.path.join(target, name)
        expected = (asset.get("digest") or "").removeprefix("sha256:")
        if not (os.path.exists(path) and os.path.getsize(path) == asset["size"]):
            print(f"downloading {name}")
            with fetch(asset["url"], "application/octet-stream", token) as response, \
                    tempfile.NamedTemporaryFile(dir=target, delete=False) as part:
                shutil.copyfileobj(response, part)
            os.replace(part.name, path)
        if expected and sha256(path) != expected:
            os.remove(path)
            sys.exit(f"{name}: checksum doesn't match GitHub's; removed it, try again")
        os.chmod(path, 0o644)
        names.append(name)

    listed = os.path.join(target, "latest.json")
    if "latest.json" in names and "latest.json.sig" in names:
        # A signed release: the list says what every file must be.
        good = signed_by_tether(listed, args.key)
        if good is False:
            sys.exit(f"Tether {version}: the signature on latest.json isn't Tether's; nothing was put in place")
        if good is None:
            print("ssh-keygen isn't installed here, so the signature wasn't checked (Tether checks it itself)")
        with open(listed, encoding="utf-8") as source:
            manifest = json.load(source)
        if str(manifest.get("version")) != version:
            sys.exit(f"latest.json is for {manifest.get('version')}, not {version}; nothing was put in place")
        for asset in manifest.get("assets", []):
            path = os.path.join(target, os.path.basename(asset["name"]))
            if not os.path.exists(path):
                sys.exit(f"{asset['name']} is in the signed list but not in the release; nothing was put in place")
            if os.path.getsize(path) != asset["size"] or sha256(path) != asset["sha256"]:
                os.remove(path)
                sys.exit(f"{asset['name']} doesn't match the signed list; removed it, try again")
        # The signature first: Tether reads the list, then its signature.
        put(listed + ".sig", os.path.join(folder, "latest.json.sig"))
        put(listed, os.path.join(folder, "latest.json"))
        print(f"latest.json: Tether {version}, {len(manifest.get('assets', []))} files, signed")
    else:
        # A release from before signing (0.5.4 and older): a list of our own,
        # which only those older versions of Tether take.
        assets = [{"name": name, "size": os.path.getsize(os.path.join(target, name)),
                   "sha256": sha256(os.path.join(target, name)), "url": f"{version}/{name}"}
                  for name in names]
        manifest = {"version": version, "notes": release.get("body") or "",
                    "page": release.get("html_url") or "", "assets": assets}
        with tempfile.NamedTemporaryFile("w", dir=folder, delete=False) as out:
            json.dump(manifest, out, indent=2)
        os.chmod(out.name, 0o644)
        os.replace(out.name, os.path.join(folder, "latest.json"))
        stale = os.path.join(folder, "latest.json.sig")
        if os.path.exists(stale):
            os.remove(stale)
        print(f"latest.json: Tether {version}, {len(assets)} files, NOT signed "
              "(Tether 0.5.5 and later won't take it from here)")

    # Older versions beyond --keep go, oldest first.
    def key(name):
        return [int(p) if p.isdigit() else 0 for p in name.split(".")]
    versions = sorted((d for d in os.listdir(folder)
                       if os.path.isdir(os.path.join(folder, d)) and d[:1].isdigit()), key=key)
    for old in versions[:-(args.keep + 1)] if args.keep >= 0 else []:
        if old != version:
            shutil.rmtree(os.path.join(folder, old))
            print(f"removed {old}")


if __name__ == "__main__":
    main()
