#!/usr/bin/env python3
"""Compares the versions Tether pins with the newest upstream ones, and prints
a Markdown report (nothing is changed). Run monthly by
.github/workflows/dependencies.yml, which keeps one open issue up to date.

    bin/check-dependencies            # report on stdout, exit 0
    bin/check-dependencies --strict   # exit 1 when something is behind

Checked: libssh and OpenSSL (the Android build), libvterm (the terminal
engine, vendored), and the Qt series the release builds use.
"""
import json
import os
import re
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def get(url):
    request = urllib.request.Request(url, headers={"User-Agent": "tether-dependency-check"})
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read().decode("utf-8", "replace")


def read(path):
    with open(os.path.join(ROOT, path), encoding="utf-8") as source:
        return source.read()


def newest(versions):
    return max(versions, key=lambda v: [int(p) for p in v.split(".")])


def libssh():
    pinned = re.search(r"^libssh_version=(\S+)", read("packaging/android/build-libssh.sh"), re.M).group(1)
    series = newest(re.findall(r'href="(\d+\.\d+)/"', get("https://www.libssh.org/files/")))
    latest = newest(re.findall(r"libssh-(\d+\.\d+\.\d+)\.tar\.xz", get(f"https://www.libssh.org/files/{series}/")))
    return "libssh", pinned, latest, "https://www.libssh.org/security/advisories/"


def openssl():
    pinned = re.search(r"^openssl_commit=(\S+)", read("packaging/android/build-libssh.sh"), re.M).group(1)
    latest = json.loads(get("https://api.github.com/repos/KDAB/android_openssl/commits/master"))["sha"]
    return "OpenSSL build (KDAB android_openssl)", pinned[:10], latest[:10], "https://github.com/KDAB/android_openssl/commits/master"


def libvterm():
    pinned = re.search(r"libvterm (\d+\.\d+(?:\.\d+)?)", read("third_party/libvterm/README.md")).group(1)
    page = get("https://launchpad.net/libvterm/trunk")
    latest = newest(re.findall(r"libvterm-(\d+\.\d+(?:\.\d+)?)\.tar\.gz", page))
    return "libvterm", pinned, latest, "https://launchpad.net/libvterm/trunk"


def qt():
    pinned = re.search(r"version: '(\d+\.\d+)\.\*'", read(".github/workflows/release.yml")).group(1)
    latest = newest(re.findall(r'href="(\d+\.\d+)/"', get("https://download.qt.io/official_releases/qt/")))
    return "Qt (release builds)", pinned + ".x", latest + ".x", "https://www.qt.io/blog"


def main():
    rows, behind, failed = [], 0, []
    for check in (libssh, openssl, libvterm, qt):
        try:
            name, pinned, latest, where = check()
        except Exception as error:  # one site being down shouldn't hide the rest
            failed.append(f"{check.__name__}: {error}")
            continue
        old = pinned != latest
        behind += old
        rows.append(f"| {name} | `{pinned}` | `{latest}` | {'**newer exists**' if old else 'up to date'} | {where} |")
    print("Pinned dependencies against the newest upstream versions.\n")
    print("| Dependency | Pinned | Newest | | Where to read what changed |")
    print("|---|---|---|---|---|")
    print("\n".join(rows))
    if failed:
        print("\nCouldn't check: " + "; ".join(failed))
    print("\nA newer version isn't necessarily urgent; read the notes for security fixes. "
          "To update: change the pin (packaging/android/build-libssh.sh, third_party/libvterm, "
          "the Qt version in .github/workflows/release.yml), run the tests, release.")
    if "--strict" in sys.argv and (behind or failed):
        sys.exit(1)


if __name__ == "__main__":
    main()
