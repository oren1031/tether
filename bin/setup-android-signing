#!/bin/sh
# Gives the release workflow Tether's Android signing key, once, so every APK
# is signed the same way and installs over the last one as an update.
#
#   bin/setup-android-signing [owner/repo]
#
# The key lives in ~/Work/tether-signing (made here if it isn't there yet).
# Back that folder up: without it, phones can't update to newer versions.
set -eu
repo="${1:-oren1031/tether}"
dir="${TETHER_SIGNING_DIR:-$HOME/Work/tether-signing}"
mkdir -p "$dir"
chmod 700 "$dir"
cd "$dir"
if [ ! -f tether-release.p12 ]; then
    echo "Making a new signing key in $dir"
    pass=$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-28)
    printf '%s' "$pass" > keystore-password.txt
    chmod 600 keystore-password.txt
    openssl req -x509 -newkey rsa:4096 -sha256 -days 10950 -nodes -keyout key.pem -out cert.pem \
        -subj "/CN=Tether" 2>/dev/null
    openssl pkcs12 -export -inkey key.pem -in cert.pem -name tether -out tether-release.p12 \
        -passout file:keystore-password.txt
    rm -f key.pem
    chmod 600 tether-release.p12
fi
base64 -w0 tether-release.p12 | gh secret set ANDROID_KEYSTORE --repo "$repo"
gh secret set ANDROID_KEYSTORE_PASSWORD --repo "$repo" < keystore-password.txt
echo "Done. Releases of $repo are now signed with the key in $dir."
echo "Back up $dir somewhere safe."
